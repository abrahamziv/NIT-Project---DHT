\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Block diagram of the decentralized detection system. The source $H^\star $ generates the hypothesis observed by $N$ sensors as $y^i \mid H_j$. Each sensor reduces its observation to the likelihood ratio $l^i = L(y^i)$, which is a sufficient statistic for $H$, and quantizes it via the threshold policy $\gamma ^i$ into a message $u^i$. The fusion center forms the statistic $\Delta _N$ from all messages together with the realized encoding policies $\gamma ^{1:N}$ (dashed), and applies the MAP rule $\gamma ^0$ to produce the decision $\hat  {H}$.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:system-model}{{1}{1}{Block diagram of the decentralized detection system. The source $H^\star $ generates the hypothesis observed by $N$ sensors as $y^i \mid H_j$. Each sensor reduces its observation to the likelihood ratio $l^i = L(y^i)$, which is a sufficient statistic for $H$, and quantizes it via the threshold policy $\gamma ^i$ into a message $u^i$. The fusion center forms the statistic $\Delta _N$ from all messages together with the realized encoding policies $\gamma ^{1:N}$ (dashed), and applies the MAP rule $\gamma ^0$ to produce the decision $\hat {H}$}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {1}Simulation 1 - One bit per sensor}{2}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Gaussian model for Setup A. A sensor decides $u^1$ if $y < \mu /2$ and $u^2$ if $y \geq \mu /2$, and always transmits its 1-bit decision.}}{2}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Gaussian model for Setup B. A sensor sends $u^1$ if $y < \lambda _1$, $u^2$ if $y \geq \lambda _2$, and stays silent (shaded region) otherwise.}}{2}{figure.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Simulation 2 - $R$ bits per sensor}{3}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Gaussian model for Setup A under Simulation 2. The observation space is partitioned by $L-1$ thresholds $t_1 < t_2 < \dots  < t_{L-1}$ into $L$ regions, each mapped to a distinct symbol $u^i \in \mathcal  {U}$; the thresholds extend beyond both means, and the sensor always transmits the $R = \log _2(L)$ bits identifying its region.}}{3}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Gaussian model for Setup B under Simulation 2. The observation space is partitioned by $L$ thresholds into $L/2$ bins on each side of the shaded silence bin, which is centered on $\mu /2$ with half-width $\delta $; a sensor stays silent if its observation falls in the shaded region, and otherwise transmits the $R=\log _2(L)$ bits identifying its region.}}{4}{figure.5}\protected@file@percent }
